# --- Database ---
DATABASE_URL=postgresql+asyncpg://smieciarka:smieciarka@localhost:5432/smieciarka

# --- JWT ---
JWT_SECRET=change-me-dev-only
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# --- OTP (demo: mocked, no real SMS gateway) ---
# any phone number accepts code 123456
OTP_MOCK=true

# --- Embeddings ---
# runs locally via fastembed, no API key or billing needed
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# not used yet (query expansion / vision / gray-zone verification are cut for the demo)
LLM_API_KEY=

# --- Matching thresholds ---
MATCH_THRESHOLD_LOW=0.55
MATCH_THRESHOLD_HIGH=0.75

# --- Listings ---
LISTING_TTL_HOURS=72
