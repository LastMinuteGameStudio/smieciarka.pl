# --- Database ---
DATABASE_URL=postgresql+asyncpg://smieciarka:smieciarka@localhost:5432/smieciarka

# --- JWT ---
JWT_SECRET=change-me-dev-only
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# --- OTP (demo: mocked, no real SMS gateway) ---
# any phone number accepts code 123456
OTP_MOCK=true

# --- Embeddings and matching ---
# "jina": hosted jina-embeddings-v3 (1024-dim) plus the reranker that decides
#   matches. Free tier, no card: https://jina.ai/embeddings
# "fastembed": local 384-dim fallback, works offline but matching is far weaker.
# Switching provider changes EMBEDDING_DIM: migrate and reindex.
EMBEDDING_PROVIDER=jina
EMBEDDING_DIM=1024
JINA_API_KEY=

# Expands "rzeczy do gry w piłkę nożną" into concrete item names. Called once
# per filter. Without it the matcher cannot separate matches from non-matches.
# Free tier, no card: https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_API_KEY=

# Local fallback model, used only when EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# unused (vision captions are cut for the demo)
LLM_API_KEY=

# --- Matching thresholds ---
# Loose cosine prefilter: nominates rerank candidates, never decides a match.
MATCH_CANDIDATE_THRESHOLD=0.0
MATCH_CANDIDATE_LIMIT=100
# The real decision, on calibrated reranker scores. Measured gap on the eval
# set: false positives peaked at 0.086, true positives bottomed at 0.111.
MATCH_RERANK_THRESHOLD=0.10

# --- Listings ---
LISTING_TTL_HOURS=72

# --- Images (object storage, S3 API) ---
# S3_ENDPOINT is what the API talks to; S3_PUBLIC_ENDPOINT is the host a
# client will fetch images from. Under docker compose these differ and the
# compose file sets both -- SigV4 signs the Host header, so a presigned URL
# must be signed for the host the client actually calls. Leave
# S3_PUBLIC_ENDPOINT empty to sign for S3_ENDPOINT (host-side venv workflow).
S3_ENDPOINT=http://localhost:4566
S3_PUBLIC_ENDPOINT=
S3_BUCKET=listing-images
S3_ACCESS_KEY=smieciarka
S3_SECRET_KEY=smieciarka-dev-only
# How long a presigned image URL stays valid, in seconds.
S3_PRESIGN_TTL=3600

MAX_IMAGES_PER_LISTING=6
MAX_IMAGE_BYTES=10485760
# Uploads are re-encoded to WebP at these bounds (longest edge, px).
IMAGE_MAX_PX=1600
THUMB_MAX_PX=480

# Vision captions reuse GEMINI_API_KEY. false keeps uploads working without
# describing the photo, so the picture stops contributing to search.
VISION_ENABLED=true
GEMINI_VISION_MODEL=gemini-flash-lite-latest

# --- Limits ---
MAX_FILTERS_PER_USER=10
